# ============================================================================
# Slovakia Visa Slot Alert — environment configuration template
#
# Copy this file to `.env` and fill in real values.
# NEVER commit `.env` to git. NEVER paste real secrets into chat, issues, or
# screenshots.
# ============================================================================

NODE_ENV=development
PORT=3001

# ---------------------------------------------------------------------------
# Polling
# ---------------------------------------------------------------------------
# Allowed values: 15, 30, 60, 120, 300 (seconds). Default 30.
# Lower values increase load on the target site — only use 15s if you have
# confirmed (manually, in a browser) that it does not trigger rate limiting.
CHECK_INTERVAL_SECONDS=30

# +/- percent randomized jitter added to every poll so requests aren't sent
# on a perfectly predictable cadence.
CHECK_JITTER_PERCENT=10

# Minutes to suppress repeat alerts for the SAME slot (same provider+date+time).
# A genuinely new date/time always alerts immediately regardless of cooldown.
ALERT_COOLDOWN_MINUTES=10

# Restart the Playwright browser after this many hours to avoid memory leaks.
BROWSER_RESTART_HOURS=6

# Days of monitor_checks / alerts history to retain in SQLite.
HISTORY_RETENTION_DAYS=30

# ---------------------------------------------------------------------------
# Target (do not change unless your requirement changes — see config/target.ts)
# ---------------------------------------------------------------------------
TARGET_COUNTRY=Slovakia
TARGET_APPLICATION_COUNTRY=India
TARGET_REGION=Delhi
TARGET_CATEGORY=D
TARGET_VISA_TYPE=Long Term
TARGET_PURPOSE=Study

# ---------------------------------------------------------------------------
# Providers
# ---------------------------------------------------------------------------
BLS_ENABLED=true
VFS_ENABLED=true

# Confirmed live 2026-08-12: VFS's application-detail deep link renders
# "Session Expired or Invalid" without a bootstrapped session.
# book-an-appointment is the real, publicly-reachable page — it states
# Long Stay/National (D-category) appointments require contacting VFS
# directly rather than a self-service calendar. See README "Selector
# verification" section for the full finding.
BLS_URL=https://appointment.blsslovakiavisa.com/app_india/login
VFS_URL=https://visa.vfsglobal.com/ind/en/svk/book-an-appointment

# Optional — only used by `npm run auth:bls` as a convenience to pre-fill the
# login form. If CAPTCHA/OTP is required (expected), you still complete login
# manually in the opened browser window. Leave blank to type everything by hand.
BLS_EMAIL=
BLS_PASSWORD=

# Run browsers headless in production. Set to false locally if you want to
# watch what the monitor is doing.
HEADLESS=true

# ---------------------------------------------------------------------------
# Mock mode — simulate providers without touching BLS/VFS at all
# ---------------------------------------------------------------------------
MOCK_PROVIDER=false

# ---------------------------------------------------------------------------
# Email (sole notification channel — this is the fast-path/primary channel)
# ---------------------------------------------------------------------------
ALERT_EMAIL=info.foreignland@proton.me

# Generic SMTP transport. Works with Proton Mail Bridge, Gmail app passwords,
# Resend's SMTP endpoint (smtp.resend.com), or any standard SMTP provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Slovakia Visa Alert <alerts@example.com>

# Alternative: Resend HTTP API instead of SMTP. If set, this takes priority
# over SMTP_* above.
RESEND_API_KEY=

# ---------------------------------------------------------------------------
# Database / persisted files
# ---------------------------------------------------------------------------
DATABASE_URL=./data/visa-alert.db
# Override these to point at a mounted persistent volume in production
# (e.g. a Fly.io volume) so BLS's login session and history survive
# restarts/redeploys instead of living on ephemeral container storage.
STORAGE_DIR=./storage
DEBUG_DIR=./debug

# ---------------------------------------------------------------------------
# API / frontend
# ---------------------------------------------------------------------------
# Comma-separated list of origins allowed to call the public /api/* endpoints.
FRONTEND_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Debug
# ---------------------------------------------------------------------------
DEBUG_MONITOR=false
