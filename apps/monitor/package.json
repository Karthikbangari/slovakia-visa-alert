{
  "name": "@slovakia-visa-alert/monitor",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "start": "node dist/src/index.js",
    "lint": "eslint src scripts --ext .ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "auth:bls": "tsx scripts/auth-bls.ts",
    "inspect:bls": "tsx scripts/inspect-bls.ts",
    "inspect:vfs": "tsx scripts/inspect-vfs.ts",
    "check:bls": "tsx scripts/test-provider.ts bls",
    "check:vfs": "tsx scripts/test-provider.ts vfs",
    "check:all": "tsx scripts/test-provider.ts all",
    "alert:test": "tsx scripts/alert-test.ts",
    "mock:no-slot": "tsx scripts/mock-run.ts no-slot",
    "mock:slot": "tsx scripts/mock-run.ts slot",
    "diagnostics": "tsx scripts/diagnostics.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.5.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.1.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "@fastify/helmet": "^13.0.0",
    "nodemailer": "^6.9.16",
    "playwright": "^1.48.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.9.0",
    "@types/nodemailer": "^6.4.16",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
